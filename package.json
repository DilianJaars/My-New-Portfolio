{
  "name": "dilian-jaars-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "tsc -p tsconfig.client.json",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "start": "node dist/server/server.js",
    "dev": "npm run build:client && tsx watch src/server/server.ts",
    "postinstall": "npm run build"
  },
  "dependencies": {
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^4.17.25",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "cookie-session": "^2.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^2.0.0",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  },
  "description": "Dilian Jaars portfolio: TypeScript, Express and plain HTML/CSS.",
  "resolutions": {
    "@types/express-serve-static-core": "4.19.9"
  },
  "overrides": {
    "@types/express-serve-static-core": "4.19.9"
  }
}
