# Copy this file to .env for local development. Never commit .env.

# Password for the "Manage" panel on the work page.
# Leave empty to switch admin login off.
ADMIN_PASSWORD=

# Any long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional. Render sets PORT itself.
PORT=3000
